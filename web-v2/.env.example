# Database
DATABASE_URL="file:./dev.db"

# JWT Secret (required, no fallback)
JWT_SECRET="change_me_to_a_long_random_string"

# Passkey / WebAuthn
PASSKEY_RP_NAME="CS-II TA Console"
PASSKEY_RP_ID="localhost"
PASSKEY_ORIGIN="http://localhost:3000"

# Teacher login (required, no fallback)
TEACHER_NAMES="吴磊,卢立"
TEACHER_PASSWORD=""

# TA roster: comma-separated student IDs allowed to sign in as TA
# e.g. TA_ROSTER="3240102049,3240102120,3240102072"
# When left empty, authorization falls back to the DB: only users already
# provisioned with role="TA" (e.g. via prisma seed) may sign in.
TA_ROSTER=""

# DingTalk robot (optional)
# DINGTALK_TOKEN=""
# DINGTALK_SECRET=""
